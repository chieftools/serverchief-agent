[Unit]
Description=Server Chief inventory agent
Documentation=https://server.chief.app
Wants=network-online.target
After=network-online.target

[Service]
# The agent sends READY=1 after its first collection round and supports
# `systemctl reload` (SIGHUP: reload config, reopen logs, collect again).
Type=notify
ExecStart=/usr/bin/serverchief run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
# Exit status 2: the backend revoked the credential. Restarting would only
# hammer the API until `serverchief setup` runs again.
RestartPreventExitStatus=2
TimeoutStartSec=5min
TimeoutStopSec=30s
KillMode=mixed

# The serverchief user reads the host with CAP_DAC_READ_SEARCH (package
# databases, vhost configs, panel data) but cannot write anything outside
# its own directories. The few things that need root (refreshing package
# lists, reading the Plesk database, installing an agent update) go through
# serverchief-helper.service, which only runs a fixed list of actions.
User=serverchief
Group=serverchief
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077

# Directives unknown to older systemd (Ubuntu 16.04 ships 229) are ignored
# with a warning, so the unit stays portable.
ProtectSystem=strict
ReadWritePaths=/var/lib/serverchief /var/log/serverchief
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_NETLINK is required to enumerate interfaces and addresses.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StateDirectory=serverchief
StateDirectoryMode=0700
LogsDirectory=serverchief
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
