#!/bin/sh
#
# serverchief  Server Chief inventory agent (SysV init script)
#
# chkconfig: 2345 90 10
# description: Collects inventory facts about this server and reports \
#              changes to Server Chief.
#
### BEGIN INIT INFO
# Provides:          serverchief
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Server Chief inventory agent
# Description:       Collects inventory facts about this server and reports
#                    changes to Server Chief. Only used on hosts without
#                    systemd; systemd hosts use serverchief.service.
### END INIT INFO

NAME=serverchief
DAEMON=/usr/bin/serverchief
PIDFILE=/var/run/serverchief.pid
LOGDIR=/var/log/serverchief
STATEDIR=/var/lib/serverchief
DAEMON_ARGS="run --log-file ${LOGDIR}/agent.log"
STOP_TIMEOUT=30

# Local overrides (for example DAEMON_ARGS or HTTPS_PROXY).
[ -r /etc/default/serverchief ] && . /etc/default/serverchief
[ -r /etc/sysconfig/serverchief ] && . /etc/sysconfig/serverchief

[ -x "$DAEMON" ] || exit 0

read_pid() {
    pid=""
    [ -f "$PIDFILE" ] || return 1
    read -r pid < "$PIDFILE" 2>/dev/null || return 1
    [ -n "$pid" ]
}

is_running() {
    read_pid || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # Guard against a recycled PID: the process must be our binary (after an
    # upgrade the link reads "/usr/bin/serverchief (deleted)").
    case "$(readlink "/proc/$pid/exe" 2>/dev/null)" in
        "$DAEMON"*) return 0 ;;
    esac
    return 1
}

do_start() {
    if is_running; then
        echo "$NAME is already running (pid $pid)."
        return 0
    fi
    rm -f "$PIDFILE"
    mkdir -p "$LOGDIR" "$STATEDIR"
    chmod 0750 "$LOGDIR"
    chmod 0700 "$STATEDIR"

    printf "Starting %s: " "$NAME"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON" -- $DAEMON_ARGS
    else
        # RHEL-likes ship no start-stop-daemon: detach by hand. Panics and
        # other stderr output that bypasses the log go to stderr.log.
        if command -v setsid >/dev/null 2>&1; then
            # shellcheck disable=SC2086
            setsid "$DAEMON" $DAEMON_ARGS </dev/null >>"$LOGDIR/stderr.log" 2>&1 &
        else
            # shellcheck disable=SC2086
            nohup "$DAEMON" $DAEMON_ARGS </dev/null >>"$LOGDIR/stderr.log" 2>&1 &
        fi
        echo $! > "$PIDFILE"
    fi

    # Give the agent a moment to fail on a bad configuration.
    sleep 1
    if is_running; then
        echo "ok"
        return 0
    fi
    echo "failed (see $LOGDIR/agent.log)"
    rm -f "$PIDFILE"
    return 1
}

do_stop() {
    if ! is_running; then
        echo "$NAME is not running."
        rm -f "$PIDFILE"
        return 0
    fi
    printf "Stopping %s: " "$NAME"
    kill -TERM "$pid" 2>/dev/null
    waited=0
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$waited" -ge "$STOP_TIMEOUT" ]; then
            kill -KILL "$pid" 2>/dev/null
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done
    rm -f "$PIDFILE"
    echo "ok"
    return 0
}

do_reload() {
    if ! is_running; then
        echo "$NAME is not running."
        return 7
    fi
    kill -HUP "$pid"
    echo "Reloaded $NAME."
}

do_status() {
    if is_running; then
        echo "$NAME is running (pid $pid)."
        return 0
    fi
    if [ -f "$PIDFILE" ]; then
        echo "$NAME is dead but the pid file exists."
        return 1
    fi
    echo "$NAME is not running."
    return 3
}

case "$1" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart|force-reload)
        do_stop
        do_start
        ;;
    try-restart|condrestart)
        if is_running; then
            do_stop
            do_start
        fi
        ;;
    reload)
        do_reload
        ;;
    status)
        do_status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|try-restart|reload|force-reload|status}" >&2
        exit 2
        ;;
esac
exit $?
